// =====================================================================
// HAProxy VM 전용 (192.168.0.179 백엔드, 181 프런트) — common.alloy 와 함께 배치
// 위치: /etc/alloy/haproxy.alloy
//
// 사전 작업:
//   1) monitoring/haproxy/prometheus-exporter.cfg 내용을 haproxy.cfg 에 추가
//   2) usermod -aG adm alloy   (/var/log/haproxy.log 읽기 권한, rsyslog 가 syslog:adm 소유로 기록)
// =====================================================================

// ---------------------------------------------------------------------
// 메트릭: HAProxy 내장 Prometheus exporter (127.0.0.1:8405)
// ---------------------------------------------------------------------
prometheus.scrape "haproxy" {
  targets         = [{ "__address__" = "127.0.0.1:8405" }]
  job_name        = "haproxy"
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.haproxy.receiver]
}

// 서버별 상세 메트릭 중 대시보드에서 쓰지 않는 것은 수집 단계에서 버려 시계열 수를 줄입니다.
prometheus.relabel "haproxy" {
  rule {
    source_labels = ["__name__"]
    regex         = "haproxy_(process_.*_total|sticktable_.*|server_(idle_connections|.*_queue_.*|.*_reuse_.*))"
    action        = "drop"
  }

  forward_to = [prometheus.remote_write.central.receiver]
}

// ---------------------------------------------------------------------
// 로그: rsyslog 가 기록하는 /var/log/haproxy.log
// ---------------------------------------------------------------------
local.file_match "haproxy" {
  path_targets = [{
    "__path__" = "/var/log/haproxy.log",
    "service"  = "haproxy",
  }]
}

loki.source.file "haproxy" {
  targets    = local.file_match.haproxy.targets
  forward_to = [loki.write.central.receiver]
}
